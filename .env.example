NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://wepov:wepov@localhost:5432/wepov
PUBLIC_ORIGIN=http://localhost:3000

# 安全密钥。SESSION_PEPPER 必填；其余留空时由它 HKDF 派生。
SESSION_PEPPER=replace-with-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
DATA_ENCRYPTION_KEY_VERSION=1
# DATA_ENCRYPTION_KEY_PREVIOUS=only-during-rotation
TREE_IDENTITY_HMAC_KEY=replace-with-32-random-bytes
CLASS_GATEWAY_PEPPER=replace-with-32-random-bytes
MAINTENANCE_SIGNING_SECRET=replace-with-32-random-bytes

# 以下三项留空时自动派生，独立设置可隔离泄露面
# PASSWORD_MATCH_KEY=
# ABUSE_HMAC_KEY=
# LOG_IP_HMAC_KEY=

# 请求体上限与媒体配额
BODY_LIMIT_BYTES=1048576
MEDIA_QUOTA_BYTES=9878424780

# 对象存储（Altare U3）
U3_ENDPOINT=https://example.invalid
U3_REGION=auto
U3_ACCESS_KEY_ID=replace-me
U3_SECRET_ACCESS_KEY=replace-me
U3_MEDIA_BUCKET=wepov-media
U3_LOG_BUCKET=wepov-logs
U3_EXPORT_BUCKET=wepov-export
U3_FORCE_PATH_STYLE=true
U3_PRESIGN_EXPIRY_SECONDS=900

# 版本门禁与自动更新
MIN_APP_VERSION_CODE=0
GITHUB_REPO=ycyz2505/WePOV
# UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/ycyz2505/WePOV/latest/update-manifest.json
UPDATE_MANIFEST_CACHE_SECONDS=300
UPDATE_MANIFEST_MIRRORS=https://cdn.jsdelivr.net/gh/ycyz2505/WePOV@latest,https://ghproxy.net/https://raw.githubusercontent.com/ycyz2505/WePOV/latest,https://raw.gitmirror.com/ycyz2505/WePOV/latest

# 反代跳数：仅在能确认代理可信时大于 0
TRUSTED_PROXY_HOPS=0

# 首次 seed 使用
SEED_GATEWAY_PASSCODE=
